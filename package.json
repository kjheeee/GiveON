{
  "name": "giveon-discord-bot",
  "version": "1.5.1",
  "private": true,
  "description": "승인·인증·개별 상품 지급을 지원하는 SQLite/MySQL 디스코드 이벤트 봇",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "register": "node --env-file-if-exists=.env scripts/register.js",
    "keygen": "node scripts/keygen.js",
    "check": "node scripts/check.js",
    "test": "node --test \"test/*.test.js\"",
    "test:mysql": "node scripts/test-mysql.js"
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "mysql2": "3.24.6"
  }
}
