# Discord Developer Portal에서 직접 발급하세요. 실제 값은 공개 저장소에 올리지 마세요.
DISCORD_TOKEN=
APPLICATION_ID=
# 봇 소유자 Discord 사용자 ID. 여러 명이면 쉼표로 구분합니다.
OWNER_IDS=
# npm run keygen으로 생성한 64자리 16진수 키. 운영 중 변경하면 기존 자료를 복호화할 수 없습니다.
DATA_KEY=
DATABASE_PATH=./data/giveaway.sqlite
# 프로젝트 전체에서 사용할 DB 하나를 선택합니다: sqlite (기본값) 또는 mysql
DB_DRIVER=sqlite
# DB_DRIVER=mysql일 때만 사용합니다. 미리 빈 DB와 전용 사용자를 만드세요.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=giveon
MYSQL_PASSWORD=
MYSQL_DATABASE=giveon
MYSQL_TIMEOUT_MS=5000
MYSQL_SSL=false
MYSQL_SSL_CA_FILE=
# 개발 서버에서 즉시 명령을 등록하려면 서버 ID 입력. 비워두면 전역 등록.
DEV_GUILD_ID=
